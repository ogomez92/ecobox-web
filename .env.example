# Media storage directory (absolute path)
MEDIA_ROOT=/path/to/media

# SQLite database file
DATABASE_URL=file:./data/ecobox.db

# Server port
PORT=3000

# Origin for CORS (production)
ORIGIN=https://your-domain.com

# App password — when set, the entire app requires this password.
#   • Browser: log in once at /login; a persistent (1-year) cookie keeps you in.
#   • iOS app: enter it once in the remote-library login; it's stored in the
#     Keychain and sent automatically, so you're never re-prompted.
# Leave empty/unset to disable the gate (e.g. if a reverse proxy handles auth).
APP_PASSWORD=

# Anthropic API key for video description ("what is happening on screen?").
# Claude is shown frames sampled from the marked segment (one per second, at most
# 50). Optional: without it the player asks for a key the first time you use the
# feature and stores it in the database instead. Read only on the server — the
# key is never sent to the browser.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5.
CLAUDE_DESCRIBE_MODEL=
